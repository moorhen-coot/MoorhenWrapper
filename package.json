{
    "name": "moorhenwrapper",
    "version": "1.0.0",
    "description": "A wrapper for Moorhen web molecular graphics program",
    "main": "webcoot.js",
    "devDependencies": {
        "@types/node": "^20",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "file-loader": "^6.2.0",
        "mini-css-extract-plugin": "^2.10.2",
        "tailwindcss": "^4",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "typescript": "^5",
        "webpack": "^5.110.3",
        "webpack-cli": "^7.2.3"
    },
    "scripts": {
        "build-cloud-dev": "webpack  --mode development --devtool inline-source-map --env destination='ccp4Cloud'",
        "build-cloud": "webpack --mode production --env destination='ccp4Cloud'",
        "force-install": "rm -rf node_modules/moorhen && rm package-lock.json && npm cache clean --force && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moorhen-coot/MoorhenWrapper.git"
    },
    "author": "",
    "bugs": {
        "url": "https://github.com/moorhen-coot/MoorhenWrapper/issues"
    },
    "homepage": "https://github.com/moorhen-coot/MoorhenWrapper#readme",
    "dependencies": {
        "moorhen": "1.1.0"
    }
}
